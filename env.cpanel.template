# Upload this file to /home/elevates/backend/.env on the server

# (File Manager → backend folder → Upload → rename to .env)

#

# Or enter the same values in cPanel → Setup Node.js App → Environment variables.



TALENTLMS_DOMAIN=lms.elevateskills.online

TALENTLMS_API_KEY=your-api-key-here

PUBLIC_LMS_URL=https://lms.elevateskills.online

ALLOWED_ORIGINS=https://elevateskills.online

BASE_PATH=/backend

SITE_URL=https://elevateskills.online

PUBLIC_API_URL=https://elevateskills.online/backend

TRUST_PROXY=1

NODE_ENV=production

CACHE_TTL_MS=300000
# Also applies to branch visibility; all branch-assigned courses are private.
# API key must be able to list branches and read each branch's courses.



# Temporary recipient until help@elevateskills.online SMTP is live
INTEREST_EMAIL_TO=kmolabi@gmail.com

CONTACT_EMAIL_TO=help@elevateskills.online

SMTP_HOST=smtp.office365.com

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=noreply@elevateskills.online

SMTP_PASS=your-m365-password

EMAIL_FROM="Elevate Skills <noreply@elevateskills.online>"

SMTP_FROM=noreply@elevateskills.online



# --- Checkout / payments ---

PAYMENT_PROVIDER=dpo

CHECKOUT_CURRENCY=BWP

# Keep these values server-side. Never place them in Angular environment files.
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/

DPO_PAYMENT_URL=https://secure.3gdirectpay.com/payv3.php

DPO_ALLOWED_HOSTS=secure.3gdirectpay.com

DPO_COMPANY_TOKEN=your-dpo-company-token

# Production service type: 113853 (Educational Services). Do not commit the
# real DPO_COMPANY_TOKEN here — set it via cPanel's Node.js App env var UI.
DPO_SERVICE_TYPE=113853

DPO_DEFAULT_PAYMENT=CC

DPO_PAYMENT_TTL_MINUTES=30

DPO_TIMEOUT_MS=15000

# Separate random secrets. Do not reuse SESSION_SECRET or ADMIN_API_KEY.
DPO_RETURN_SECRET=generate-at-least-32-random-bytes

# Exactly 32 random bytes, encoded as base64 (keep backed up securely).
DATA_ENCRYPTION_KEY=generate-32-random-bytes-as-base64

# Change to a strong random value before go-live
ADMIN_API_KEY=change-me-strong-random-key



# --- MySQL (REQUIRED for checkout — without this you get 503) ---
# cPanel → MySQL Databases:
#   1) Create database
#   2) Create user + password
#   3) Add user to database with ALL PRIVILEGES
# Use the FULL names shown in cPanel (usually prefixed), e.g.:
#   DB_NAME=elevates_elevatekills
#   DB_USER=elevates_dbuser
#
# After setting these, Restart the Node app.
# Then open /backend/health — you must see "database":{"ok":true,...}
# If tables are still missing, run schema.sql in phpMyAdmin.

DB_HOST=localhost
DB_PORT=3306
DB_USER=your-cpanel-db-user
DB_PASSWORD=your-cpanel-db-password
DB_NAME=your-cpanel-db-name



# Do NOT set PORT on cPanel — the host assigns it automatically.

