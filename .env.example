# Your TalentLMS hostname WITHOUT protocol (custom LMS domain supported)
# This is the domain you use to log into the TalentLMS admin portal.
TALENTLMS_DOMAIN=lms.elevateskills.online

# API key from: TalentLMS admin -> Account & Settings -> Basic settings -> API
# Keep this secret. It must NEVER ship to the browser.
TALENTLMS_API_KEY=your-talentlms-api-key

# Public-facing learner URL for login, register, and course catalog links.
# Use your TalentLMS portal host (e.g. lms.elevateskills.online).
# Leave blank to fall back to https://${TALENTLMS_DOMAIN}.
PUBLIC_LMS_URL=https://lms.elevateskills.online

# Origins that are allowed to call this proxy. Leave blank to allow all (dev only).
# In production, set to your frontend origin, e.g. https://elevateskills.co.bw
# Required for cookie-based site login (credentials).
ALLOWED_ORIGINS=http://localhost:4200

# Public frontend URL (used for LMS logout redirect after site login).
SITE_URL=http://localhost:4200

# Public URL for this backend. Use the production HTTPS URL for DPO returns.
PUBLIC_API_URL=http://localhost:4000

# Secret for signing Elevate Skills session cookies. Use a long random string in production.
SESSION_SECRET=change-me-long-random-session-secret

# Set true behind HTTPS in production so the session cookie is Secure.
# COOKIE_SECURE=true

# How long to cache TalentLMS responses (ms). Default: 5 minutes.
CACHE_TTL_MS=300000
# Also bounds verified branch visibility. All branch-assigned courses are private.
# Branch lookup failure after expiry returns 503; stale visibility is never used.

# Register Your Interest form — emails go here (comma-separated for multiple recipients)
INTEREST_EMAIL_TO=kmolabi@gmail.com

# Contact page form — enquiries delivered here
CONTACT_EMAIL_TO=help@elevateskills.online

# Demo / corporate / trainer forms (comma-separated ok). Also CCs CONTACT_EMAIL_TO.
# Defaults to CONTACT_EMAIL_TO when unset.
SALES_EMAIL_TO=sales@elevateskills.online,help@elevateskills.online

# SMTP (required on production to send emails; logs to console if unset)
# Microsoft 365 example (Authenticated SMTP must be enabled on the sender mailbox)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@elevateskills.online
SMTP_PASS=
EMAIL_FROM="Elevate Skills <noreply@elevateskills.online>"
SMTP_FROM=noreply@elevateskills.online

# Port for the proxy server (cPanel sets this automatically).
PORT=4000

# URL prefix when hosted in a subfolder (e.g. cPanel Application URL /backend).
# Local dev: leave blank. Production cPanel: set to /backend
BASE_PATH=

# --- MySQL (required for checkout/orders) ---
# On cPanel: MySQL Databases → create DB + user → grant ALL PRIVILEGES
# Names are usually prefixed, e.g. elevates_elevatekills / elevates_dbuser
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=elevatekills

# Checkout
PAYMENT_PROVIDER=mock
CHECKOUT_CURRENCY=BWP
ADMIN_API_KEY=change-me-strong-random-key

# DPO Pay v6 hosted checkout. Keep all values server-side.
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_PAYMENT_URL=https://secure.3gdirectpay.com/payv3.php
DPO_ALLOWED_HOSTS=secure.3gdirectpay.com
DPO_COMPANY_TOKEN=your-dpo-company-token
DPO_SERVICE_TYPE=54842
DPO_DEFAULT_PAYMENT=CC
DPO_PAYMENT_TTL_MINUTES=30
DPO_TIMEOUT_MS=15000
DPO_RETURN_SECRET=generate-at-least-32-random-bytes

# Exactly 32 random bytes encoded as base64. Required for DPO and production.
DATA_ENCRYPTION_KEY=generate-32-random-bytes-as-base64
