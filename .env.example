# Your TalentLMS subdomain WITHOUT protocol (e.g. elevateskills.talentlms.com)
# This is the domain you use to log into the TalentLMS admin portal.
TALENTLMS_DOMAIN=elevateskillsadmin.talentlms.com

# API key from: TalentLMS admin -> Account & Settings -> Basic settings -> API
# Keep this secret. It must NEVER ship to the browser.
TALENTLMS_API_KEY=SHmzlmiabiGz1fnyd2CUUcL1RSxvZx

# Public-facing learner URL for login, register, and course catalog links.
# Use your TalentLMS portal host (e.g. elevateskillsadmin.talentlms.com).
# Leave blank to fall back to https://${TALENTLMS_DOMAIN}.
PUBLIC_LMS_URL=https://elevateskillsadmin.talentlms.com

# Origins that are allowed to call this proxy. Leave blank to allow all (dev only).
# In production, set to your frontend origin, e.g. https://elevateskills.co.bw
ALLOWED_ORIGINS=http://localhost:4200

# How long to cache TalentLMS responses (ms). Default: 5 minutes.
CACHE_TTL_MS=300000

# Register Your Interest form — emails go here (comma-separated for multiple recipients)
INTEREST_EMAIL_TO=kmolabi@gmail.com

# Contact page form — enquiries delivered here
CONTACT_EMAIL_TO=help@elevateskills.online

# SMTP (required on production to send emails; logs to console if unset)
# Microsoft 365 example (Authenticated SMTP must be enabled on the sender mailbox)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@elevateskills.online
SMTP_PASS=
EMAIL_FROM="Elevate Skills <noreply@elevateskills.online>"
SMTP_FROM=noreply@elevateskills.online

# Port for the proxy server (cPanel sets this automatically).
PORT=4000

# URL prefix when hosted in a subfolder (e.g. cPanel Application URL /backend).
# Local dev: leave blank. Production cPanel: set to /backend
BASE_PATH=

# --- MySQL (required for checkout/orders) ---
# On cPanel: MySQL Databases → create DB + user → grant ALL PRIVILEGES
# Names are usually prefixed, e.g. elevates_elevatekills / elevates_dbuser
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=elevatekills

# Checkout
PAYMENT_PROVIDER=mock
CHECKOUT_CURRENCY=BWP
ADMIN_API_KEY=change-me-strong-random-key
